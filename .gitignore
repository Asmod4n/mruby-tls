## Environment normalisation:
/.bundle/
/lib/bundler/man/

# for a library or gem, you might want to ignore these files since the code is
# intended to run in multiple environments; otherwise, check them in:
# Gemfile.lock
# .ruby-version
# .ruby-gemset

# unless supporting rvm < 1.11.0 or doing something fancy, ignore this:
.rvmrc
build_config.rb.lock
.cache
compile_commands.json
/mruby/
/.vscode/

# Copied at build time by mrbgem.rake out of mbedTLS's own install
# prefix (see its comment there) so dependent gems can #include
# <mbedtls/...> / <psa/...> - build output, not tracked source. This
# gem's own public header, include/mruby/tls.h, stays tracked.
/include/mbedtls/
/include/psa/
/include/tf-psa-crypto/
